generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/////////////////////
// ENUMS (MUST COME FIRST)
/////////////////////

enum CommunityType {
  PUBLIC
  GAMING
  ART
  MUSIC
  TECHNOLOGY
  SPORTS
  FINANCE
  LIFESTYLE
  TRAVEL
  EDUCATION
  OTHER
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum RoomType {
  ANNOUNCEMENT
  GENERAL
  VOICE_CHAT
  POSTS
  VS_BATTLE
}

/////////////////////
// BATTLE
/////////////////////
model Battle {
  id        BigInt    @id @default(autoincrement())
  status    String    @default("ACTIVE") // ACTIVE, COMPLETED
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  roomId BigInt
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  post1Id BigInt
  post2Id BigInt
  post1   Post   @relation("post1Battles", fields: [post1Id], references: [id], onDelete: Cascade)
  post2   Post   @relation("post2Battles", fields: [post2Id], references: [id], onDelete: Cascade)

  votes BattleVote[]

  @@map("battles")
}

model BattleVote {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now())

  battleId BigInt
  userId   BigInt
  postId   BigInt // The post the user voted for

  battle Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([battleId, userId])
  @@map("battle_votes")
}

enum PostType {
  IMAGE
  VIDEO
}

/////////////////////
// USER
/////////////////////
model User {
  id        BigInt  @id @default(autoincrement())
  username  String  @unique
  email     String  @unique
  password  String?
  avatarUrl String?
  bannerUrl String?
  age       Int?

  posts       Post[]
  comments    Comment[]
  likes       PostLike[]
  messages    Message[]
  sentDMs     DirectMessage[] @relation("sentMessages")
  receivedDMs DirectMessage[] @relation("receivedMessages")
  memberships Membership[]
  battleVotes BattleVote[]

  @@map("users")
}

/////////////////////
// COMMUNITY
/////////////////////
model Community {
  id          BigInt        @id @default(autoincrement())
  name        String        @unique
  description String?
  bannerUrl   String?
  type        CommunityType

  rooms       Room[]
  memberships Membership[]

  @@map("communities")
}

/////////////////////
// MEMBERSHIP
/////////////////////
model Membership {
  id       BigInt         @id @default(autoincrement())
  role     MembershipRole
  joinedAt DateTime?

  userId      BigInt
  communityId BigInt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@map("memberships")
}

/////////////////////
// ROOM
/////////////////////
model Room {
  id            BigInt    @id @default(autoincrement())
  name          String
  type          RoomType
  config        String?
  isDefaultRoom Boolean   @default(false)
  readOnly      Boolean   @default(false)
  adminOnly     Boolean   @default(false)
  locked        Boolean   @default(false)
  createdAt     DateTime?

  communityId BigInt
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  posts    Post[]
  messages Message[]
  battles  Battle[]

  @@map("rooms")
}

/////////////////////
// POST
/////////////////////
model Post {
  id        BigInt    @id @default(autoincrement())
  mediaUrl  String
  caption   String?
  type      PostType
  createdAt DateTime?

  roomId BigInt
  userId BigInt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  comments     Comment[]
  likes        PostLike[]
  battlesAsP1  Battle[]   @relation("post1Battles")
  battlesAsP2  Battle[]   @relation("post2Battles")

  @@map("posts")
}

/////////////////////
// COMMENT
/////////////////////
model Comment {
  id        BigInt    @id @default(autoincrement())
  content   String
  createdAt DateTime?

  postId BigInt
  userId BigInt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("comments")
}

/////////////////////
// POST LIKE
/////////////////////
model PostLike {
  id BigInt @id @default(autoincrement())

  postId BigInt
  userId BigInt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

/////////////////////
// ROOM MESSAGE
/////////////////////
model Message {
  id          BigInt    @id @default(autoincrement())
  content     String?
  contentType String?
  createdAt   DateTime?

  roomId BigInt
  userId BigInt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("messages")
}

/////////////////////
// DIRECT MESSAGE
/////////////////////
model DirectMessage {
  id        BigInt    @id @default(autoincrement())
  content   String?
  createdAt DateTime?
  read      Boolean   @default(false)

  senderId   BigInt
  receiverId BigInt

  sender   User @relation("sentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("receivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("direct_messages")
}
